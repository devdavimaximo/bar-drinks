{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "types": ["vite/client"]
  },
  // o TS 7 não acha arquivos por glob dentro do OneDrive: as entradas puxam o resto pelos imports
  "files": ["src/main.tsx", "src/dev/lab.tsx"]
}
